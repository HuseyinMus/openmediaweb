# ─────────────────────────────────────────────────────────────
# Open Media — environment variables
# Copy to .env.local for local development. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional public contact channels. Leave empty to show "yakında" (coming soon).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# ── Firebase (server only) ───────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web app config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Dedicated Email/Password user used ONLY by /api/contact to write submissions.
# Its UID must be placed in firestore.rules.
FIREBASE_CONTACT_WRITER_EMAIL=
FIREBASE_CONTACT_WRITER_PASSWORD=

# ── E-mail notifications via Resend (server only) ────────────
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Open Media <form@yourdomain.com>"
CONTACT_FROM_EMAIL=
# One or more recipients, comma separated
CONTACT_TO_EMAIL=
